FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_APPWRITE_API_ENDPOINT
ARG VITE_APPWRITE_PROJECT_ID
ARG VITE_APPWRITE_DATABASE_ID
ARG VITE_APPWRITE_USERS_TABLE_ID
ARG VITE_APPWRITE_TRIPS_TABLE_ID
ARG VITE_APPWRITE_ADMIN_REQUESTS_TABLE_ID
ARG VITE_SYNCFUSION_LICENSE_KEY
ENV VITE_APPWRITE_API_ENDPOINT=$VITE_APPWRITE_API_ENDPOINT \
    VITE_APPWRITE_PROJECT_ID=$VITE_APPWRITE_PROJECT_ID \
    VITE_APPWRITE_DATABASE_ID=$VITE_APPWRITE_DATABASE_ID \
    VITE_APPWRITE_USERS_TABLE_ID=$VITE_APPWRITE_USERS_TABLE_ID \
    VITE_APPWRITE_TRIPS_TABLE_ID=$VITE_APPWRITE_TRIPS_TABLE_ID \
    VITE_APPWRITE_ADMIN_REQUESTS_TABLE_ID=$VITE_APPWRITE_ADMIN_REQUESTS_TABLE_ID \
    VITE_SYNCFUSION_LICENSE_KEY=$VITE_SYNCFUSION_LICENSE_KEY
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/build ./build
COPY instrument.server.mjs ./
USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
CMD ["sh", "-c", "NODE_OPTIONS='--import ./instrument.server.mjs' ./node_modules/.bin/react-router-serve ./build/server/index.js"]